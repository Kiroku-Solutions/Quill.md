{
	"name": "quill-md",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/add-sri.mjs && node scripts/check-csp.mjs",
		"preview": "vite preview",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:i18n": "node scripts/check-i18n.mjs",
		"check:csp": "node scripts/check-csp.mjs",
		"audit": "pnpm audit --audit-level=high --ignore GHSA-w3rx-r6r6-pgpr --ignore GHSA-5p2g-fcmc-qvqq",
		"lint": "pnpm run audit && prettier --check . && eslint . && node scripts/check-i18n.mjs && node scripts/check-csp.mjs",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest --run",
		"coverage": "vitest --run --coverage",
		"sri": "node scripts/add-sri.mjs",
		"generate:mocks": "tsx scripts/generate-mock-graph.ts",
		"commit": "cz"
	},
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@hocuspocus/server": "^4.5.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/file-saver": "^2.0.7",
		"@types/html-to-docx": "^1.8.1",
		"@types/js-yaml": "^4.0.9",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^24.13.3",
		"@types/ws": "^8.18.1",
		"@vitest/browser-playwright": "^4.1.10",
		"@vitest/coverage-v8": "^4.1.10",
		"axe-core": "^4.13.0",
		"commitizen": "^4.3.2",
		"cz-conventional-changelog": "^3.3.0",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.9.0",
		"html-to-docx": "^1.8.0",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.2.1",
		"vite-plugin-node-polyfills": "^0.28.0",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^2.2.1"
	},
	"dependencies": {
		"3d-force-graph": "^1.80.0",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.12.4",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.8",
		"@hocuspocus/provider": "^4.5.0",
		"@lezer/highlight": "^1.2.3",
		"@lucide/svelte": "^1.30.0",
		"@octokit/plugin-retry": "^8.1.1",
		"@octokit/plugin-throttling": "^11.0.5",
		"@octokit/request-error": "^7.1.1",
		"@octokit/rest": "^22.0.1",
		"async-lock": "^1.4.1",
		"codemirror": "^6.0.2",
		"dompurify": "^3.4.13",
		"file-saver": "^2.0.5",
		"force-graph": "^1.51.4",
		"idb": "^8.0.3",
		"js-yaml": "^4.3.1",
		"marked": "^18.0.9",
		"mermaid": "^11.16.1",
		"y-codemirror.next": "^0.3.5",
		"y-indexeddb": "^9.0.12",
		"y-protocols": "^1.0.7",
		"yjs": "^13.6.32"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	}
}
